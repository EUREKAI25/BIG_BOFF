      "dependencies": ["brand_identity"],
      "test_function": "test_endpoint_logo_generate",
      "example": {
        "input":  {"brief": "FPS esports platform", "context": {"name": "FrostByte", "family": "gaming"}},
        "output": {"type": "symbol", "style": "bold geometric", "svg_spec": {"shape": "diamond"}}
      }
    },
    {
      "name": "design.icons.generate",
      "category": "design",
      "type": "endpoint",
      "goal": "Générer uniquement le système d'icônes de l'identité visuelle",
