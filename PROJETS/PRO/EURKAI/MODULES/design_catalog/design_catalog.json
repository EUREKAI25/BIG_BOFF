{
  "version": "1.1.0",
  "category": "design",
  "generated_at": "2026-03-22",
  "entries": [
    {
      "name": "design.visual_intent.generate",
      "category": "design",
      "type": "endpoint",
      "goal": "Transformer un brief textuel en direction artistique structurée",
      "mission": "Générer le visual_intent qui pilote tous les modules aval (palette, plan, rendu)",
      "inputs": {
        "brief":              {"type": "str",       "required": true,  "description": "Brand/project description"},
        "style_dna":          {"type": "dict|None", "required": false, "description": "Style DNA overrides"},
        "constraints":        {"type": "dict|None", "required": false, "description": "Hard constraints on intent"},
        "reference_image":    {"type": "str|None",  "required": false, "description": "Path to reference image (CASE 1)"},
        "reference_type":     {"type": "str|None",  "required": false, "description": "none | image | screenshot | mockup"},
        "reference_analysis": {"type": "dict|None", "required": false, "description": "Structural analysis from design.coherence.apply (CASE 3)"}
      },
      "outputs": {
        "visual_intent": {"type": "dict", "description": "emotion, mood, archetype, composition_bias, typography_strategy, color_strategy, ..."}
      },
      "dependencies": ["visual_intent_engine"],
      "test_function": "test_endpoint_visual_intent_generate",
      "example": {
        "input":  {"brief": "Distillerie normande, calvados artisanal 1887, premium"},
        "output": {"emotion": "nostalgie", "mood": "warm", "archetype": "craft_premium"}
      }
    },
    {
      "name": "design.palette.generate",
      "category": "design",
      "type": "endpoint",
      "goal": "Générer une palette couleur accessible et contextuelle",
      "mission": "Produire un système couleur WCAG AA depuis le visual_intent",
      "inputs": {
        "visual_intent": {"type": "dict",      "required": true,  "description": "From design.visual_intent.generate"},
        "context":       {"type": "dict|None", "required": false, "description": "{mode, name, family}"}
      },
      "outputs": {
        "palette": {"type": "dict", "description": "primary, background, text_primary, accent, body_text_grade, ..."}
      },
      "dependencies": ["color_palette"],
      "test_function": "test_endpoint_palette_generate",
      "example": {
        "input":  {"visual_intent": {"context": {"emotional_goal": "trust"}}, "context": {"mode": "dark"}},
        "output": {"primary": "#2563EB", "background": "#0F172A", "body_text_grade": "AAA"}
      }
    },
    {
      "name": "design.coherence.apply",
      "category": "design",
      "type": "endpoint",
      "goal": "Appliquer les règles de cohérence visuelle image↔palette",
      "mission": "Gérer les 3 modes : image drives palette, palette drives image, design reference drives plan",
      "inputs": {
        "visual_intent":   {"type": "dict",      "required": true,  "description": "From design.visual_intent.generate"},
        "context":         {"type": "dict",      "required": true,  "description": "{mode, name, family}"},
        "palette":         {"type": "dict|None", "required": false, "description": "From design.palette.generate"},
        "reference_image": {"type": "str|None",  "required": false, "description": "Path to image/screenshot/mockup"},
        "reference_type":  {"type": "str",       "required": false, "description": "none | image | screenshot | mockup"}
      },
      "outputs": {
        "reference_mode":     {"type": "str",  "description": "image_drives_palette | palette_drives_image | design_reference_drives_plan"},
        "reference_analysis": {"type": "dict", "description": "dominance, density, hierarchy, spacing, composition_bias, palette_hint (CASE 3)"},
        "palette":            {"type": "dict", "description": "Palette finale"},
        "image_adjustments":  {"type": "dict", "description": "CSS: duotone, overlay_color, overlay_opacity, filter, blend_mode"},
        "readability_rules":  {"type": "dict", "description": "WCAG: text_on_image, min_overlay_for_wcag, gradient_scrim, recommended_text_color"},
        "conflicts":          {"type": "list", "description": "Conflits détectés"}
      },
      "dependencies": ["visual_coherence_engine"],
      "test_function": "test_endpoint_coherence_apply",
      "example": {
        "input":  {"visual_intent": {}, "context": {"mode": "dark", "name": "TestCo"}, "reference_type": "none"},
        "output": {"reference_mode": "palette_drives_image", "conflicts": []}
      }
    },
    {
      "name": "design.plan.generate",
      "category": "design",
      "type": "endpoint",
      "goal": "Générer un plan de composition déterministe avant le rendu",
      "mission": "Définir layout_strategy, hero, sections, tension, rythme depuis le brief",
      "inputs": {
        "brief":              {"type": "str",       "required": true,  "description": "Brand/project description"},
        "seed":               {"type": "int",       "required": false, "description": "Determinism seed (default: 42)"},
        "visual_intent":      {"type": "dict|None", "required": false, "description": "From design.visual_intent.generate"},
        "reference_analysis": {"type": "dict|None", "required": false, "description": "CASE 3 hard overrides"},
        "style_dna":          {"type": "dict|None", "required": false, "description": "Style DNA"},
        "theme_hints":        {"type": "dict|None", "required": false, "description": "Theme hints"}
      },
      "outputs": {
        "plan": {"type": "dict", "description": "layout_strategy, hero, composition, visual_tension, rhythm, constraints, section_types, cta_strategy, seed, brief_profile"}
      },
      "dependencies": ["design_plan"],
      "test_function": "test_endpoint_plan_generate",
      "example": {
        "input":  {"brief": "SaaS B2B analytics", "seed": 42},
        "output": {"layout_strategy": "asymmetric_split", "brief_profile": "structural"}
      }
    },
    {
      "name": "design.render.page",
      "category": "design",
      "type": "endpoint",
      "goal": "Générer une page HTML complète depuis brief + palette",
      "mission": "Produire le HTML rendu avec CSS vars injectées depuis la palette",
      "inputs": {
        "project_name": {"type": "str",       "required": true,  "description": "Brand/project name"},
        "brief_text":   {"type": "str",       "required": true,  "description": "Brand description"},
        "site_family":  {"type": "str",       "required": false, "description": "Template family"},
        "seed":         {"type": "int",       "required": false, "description": "Render seed"},
        "cp_palette":   {"type": "dict|None", "required": false, "description": "Color palette"},
        "dna":          {"type": "any|None",  "required": false, "description": "DesignDNA object"},
        "exploration":  {"type": "any|None",  "required": false, "description": "Exploration result"},
        "preset":       {"type": "dict|None", "required": false, "description": "Theme preset"},
        "css":          {"type": "str|None",  "required": false, "description": "Extra CSS"}
      },
      "outputs": {
        "html":         {"type": "str", "description": "HTML complet"},
        "project_name": {"type": "str", "description": "Echo project_name"},
        "seed":         {"type": "int", "description": "Echo seed"},
        "site_family":  {"type": "str", "description": "Echo site_family"}
      },
      "dependencies": ["generate_brand_charter"],
      "test_function": "test_endpoint_render_page",
      "example": {
        "input":  {"project_name": "Synaptic", "brief_text": "SaaS analytics B2B", "site_family": "product_saas"},
        "output": {"html": "<!doctype html>...", "seed": 42}
      }
    },
    {
      "name": "design.capture.page",
      "category": "design",
      "type": "endpoint",
      "goal": "Capturer les screenshots des zones audit d'une page",
      "mission": "Produire les captures PNG par zone (nav, hero, sections, cta) pour l'audit vision",
      "inputs": {
        "url":         {"type": "str",       "required": true,  "description": "URL de la page"},
        "site":        {"type": "str",       "required": true,  "description": "Identifiant site"},
        "page":        {"type": "str",       "required": true,  "description": "Identifiant page"},
        "output_root": {"type": "str",       "required": false, "description": "Répertoire captures"},
        "viewport":    {"type": "str",       "required": false, "description": "desktop | tablet | mobile"},
        "zones":       {"type": "list|None", "required": false, "description": "Zones à capturer"}
      },
      "outputs": {
        "captures":   {"type": "list[dict]", "description": "ok, path, zone, viewport, error, duration_ms"},
        "ok_count":   {"type": "int",        "description": "Captures réussies"},
        "fail_count": {"type": "int",        "description": "Captures échouées"}
      },
      "dependencies": ["screenshot_capture", "playwright"],
      "test_function": "test_endpoint_capture_page",
      "example": {
        "input":  {"url": "http://localhost:8080/page.html", "site": "synaptic", "page": "landing"},
        "output": {"captures": [{"ok": true, "zone": "hero", "path": "output/captures/..."}], "ok_count": 6}
      }
    },
    {
      "name": "design.audit.page",
      "category": "design",
      "type": "endpoint",
      "goal": "Auditer la lisibilité d'une page via vision API",
      "mission": "Évaluer chaque zone (score 0–100, seuil 70) et produire les quick_fixes",
      "inputs": {
        "captures": {"type": "list[dict]", "required": true,  "description": "From design.capture.page output['captures']"},
        "api_key":  {"type": "str|None",   "required": false, "description": "Anthropic API key"}
      },
      "outputs": {
        "results": {"type": "list[dict]", "description": "readability_pass, global_score, issues, quick_fixes, zone"},
        "summary": {"type": "dict",       "description": "pass, fail, avg_score, total, high_issues"},
        "pass":    {"type": "bool",       "description": "True si toutes zones ≥ 70"},
        "score":   {"type": "int",        "description": "Score moyen (0–100)"}
      },
      "dependencies": ["vision_audit", "anthropic"],
      "test_function": "test_endpoint_audit_page",
      "example": {
        "input":  {"captures": [{"ok": true, "zone": "hero", "path": "hero.png"}]},
        "output": {"pass": true, "score": 88, "summary": {"pass": 6, "fail": 0}}
      }
    },
    {
      "name": "design.fix.page",
      "category": "design",
      "type": "endpoint",
      "goal": "Appliquer un patch CSS correctif depuis les résultats d'audit",
      "mission": "Calculer et injecter les corrections (text_color, overlay, font_weight) pour passer le seuil 70",
      "inputs": {
        "html":          {"type": "str",        "required": true,  "description": "HTML depuis design.render.page"},
        "audit_results": {"type": "list[dict]", "required": true,  "description": "Depuis design.audit.page output['results']"},
        "iteration":     {"type": "int",        "required": false, "description": "Itération courante (default: 1)"},
        "target_score":  {"type": "int",        "required": false, "description": "Score cible (default: 70)"}
      },
      "outputs": {
        "html":         {"type": "str",       "description": "HTML corrigé"},
        "converged":    {"type": "bool",      "description": "True si toutes zones passaient déjà"},
        "iteration":    {"type": "int",       "description": "Echo itération"},
        "final_scores": {"type": "dict",      "description": "zone → score avant patch"},
        "patch_zones":  {"type": "list[str]", "description": "Zones patchées"}
      },
      "dependencies": ["auto_fix_engine", "vision_audit"],
      "test_function": "test_endpoint_fix_page",
      "example": {
        "input":  {"html": "...", "audit_results": [{"zone": "hero", "global_score": 55, "readability_pass": false}]},
        "output": {"converged": false, "patch_zones": ["hero"], "iteration": 1}
      }
    },
    {
      "name": "design.page.generate_basic",
      "category": "design",
      "type": "scenario",
      "goal": "Générer une page complète depuis un brief (pipeline minimal)",
      "mission": "Enchaîner visual_intent → palette → plan → render sans référence externe",
      "inputs": {
        "brief":        {"type": "str", "required": true,  "description": "Brand/project description"},
        "project_name": {"type": "str", "required": true,  "description": "Brand name"},
        "seed":         {"type": "int", "required": false, "description": "Seed de rendu"},
        "site_family":  {"type": "str", "required": false, "description": "Famille de template"}
      },
      "outputs": {
        "html":          {"type": "str",  "description": "HTML rendu"},
        "visual_intent": {"type": "dict", "description": "Visual intent généré"},
        "palette":       {"type": "dict", "description": "Palette"},
        "plan":          {"type": "dict", "description": "Design plan"},
        "trace":         {"type": "list", "description": "Trace d'exécution"}
      },
      "dependencies": [
        "design.visual_intent.generate",
        "design.palette.generate",
        "design.plan.generate",
        "design.render.page"
      ],
      "test_function": "test_scenario_page_generate_basic",
      "example": {
        "input":  {"brief": "SaaS analytics B2B", "project_name": "Synaptic", "seed": 42},
        "output": {"html": "<!doctype html>...", "trace": [{"step": 1}, {"step": 2}, {"step": 3}, {"step": 4}]}
      }
    },
    {
      "name": "design.page.generate_from_image",
      "category": "design",
      "type": "scenario",
      "goal": "Générer une page dont la palette est extraite d'une image de référence",
      "mission": "CASE 1 — image_drives_palette : analyse PIL + palette from image → rendu cohérent",
      "inputs": {
        "brief":           {"type": "str", "required": true, "description": "Brand/project description"},
        "project_name":    {"type": "str", "required": true, "description": "Brand name"},
        "reference_image": {"type": "str", "required": true, "description": "Chemin vers l'image de référence"},
        "seed":            {"type": "int", "required": false, "description": "Seed"},
        "site_family":     {"type": "str", "required": false, "description": "Template family"}
      },
      "outputs": {
        "html":          {"type": "str",  "description": "HTML rendu"},
        "visual_intent": {"type": "dict", "description": "Visual intent"},
        "coherence":     {"type": "dict", "description": "reference_mode=image_drives_palette"},
        "plan":          {"type": "dict", "description": "Design plan"},
        "trace":         {"type": "list", "description": "Trace"}
      },
      "dependencies": [
        "design.visual_intent.generate",
        "design.coherence.apply",
        "design.plan.generate",
        "design.render.page"
      ],
      "test_function": "test_scenario_page_generate_from_image",
      "example": {
        "input":  {"brief": "Galerie d'art contemporain", "project_name": "Zénith", "reference_image": "/path/to/photo.jpg"},
        "output": {"coherence": {"reference_mode": "image_drives_palette"}}
      }
    },
    {
      "name": "design.page.generate_from_mockup",
      "category": "design",
      "type": "scenario",
      "goal": "Générer une page dont la structure est inspirée d'un mockup ou screenshot",
      "mission": "CASE 3 — design_reference_drives_plan : analyse structurelle → overrides plan (profile/density/tension)",
      "inputs": {
        "brief":           {"type": "str", "required": true,  "description": "Brand/project description"},
        "project_name":    {"type": "str", "required": true,  "description": "Brand name"},
        "reference_image": {"type": "str", "required": true,  "description": "Chemin vers mockup ou screenshot"},
        "reference_type":  {"type": "str", "required": false, "description": "mockup | screenshot (default: mockup)"},
        "seed":            {"type": "int", "required": false, "description": "Seed"},
        "site_family":     {"type": "str", "required": false, "description": "Template family"}
      },
      "outputs": {
        "html":              {"type": "str",  "description": "HTML rendu"},
        "visual_intent":     {"type": "dict", "description": "Visual intent"},
        "palette":           {"type": "dict", "description": "Palette"},
        "coherence":         {"type": "dict", "description": "reference_mode=design_reference_drives_plan"},
        "reference_analysis":{"type": "dict", "description": "dominance, density, hierarchy, spacing..."},
        "plan":              {"type": "dict", "description": "Plan avec hard overrides"},
        "trace":             {"type": "list", "description": "Trace"}
      },
      "dependencies": [
        "design.visual_intent.generate",
        "design.palette.generate",
        "design.coherence.apply",
        "design.plan.generate",
        "design.render.page"
      ],
      "test_function": "test_scenario_page_generate_from_mockup",
      "example": {
        "input":  {"brief": "Agence design Berlin", "project_name": "Forma", "reference_image": "/path/to/mockup.png", "reference_type": "mockup"},
        "output": {"coherence": {"reference_mode": "design_reference_drives_plan"}, "reference_analysis": {"dominance": "text"}}
      }
    },
