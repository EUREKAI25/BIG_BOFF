        "output": {"brand_identity": {"logo": {"type": "logotype"}, "typography": {"primary_font": "Cormorant Garamond"}}, "trace": [{"step": 1}, {"step": 2}, {"step": 3}]}
      }
    },
    {
      "name": "design.brand.generate_from_reference",
      "category": "design",
      "type": "scenario",
      "goal": "Pipeline brand identity depuis brief + mockup/screenshot de référence (CASE 3)",
      "mission": "Analyser la structure d'un mockup pour overrider l'identité — adapte sans copier",
      "inputs": {
        "brief":           {"type": "str", "required": true,  "description": "Brand/project description"},
        "context":         {"type": "dict","required": true,  "description": "{name, mode, family, ...}"},
        "reference_image": {"type": "str", "required": true,  "description": "Chemin vers mockup ou screenshot"},
        "reference_type":  {"type": "str", "required": false, "description": "mockup | screenshot (default: mockup)"}
      },
      "outputs": {
        "brand_identity":    {"type": "dict", "description": "Identité avec overrides de référence"},
        "visual_intent":     {"type": "dict", "description": "Visual intent"},
        "palette":           {"type": "dict", "description": "Palette"},
        "coherence":         {"type": "dict", "description": "Cohérence + reference_analysis"},
        "reference_analysis":{"type": "dict", "description": "dominance, density, hierarchy, spacing..."},
        "reference_mode":    {"type": "str",  "description": "design_reference_drives_plan"},
        "trace":             {"type": "list", "description": "Trace d'exécution [4 steps]"}
      },
      "dependencies": [
        "design.visual_intent.generate",
        "design.palette.generate",
        "design.coherence.apply",
        "design.brand.generate"
      ],
      "test_function": "test_scenario_brand_generate_from_reference",
      "example": {
        "input":  {"brief": "Agence design Berlin premium", "context": {"name": "Forma", "mode": "light"}, "reference_image": "/path/to/mockup.png"},
        "output": {"reference_mode": "design_reference_drives_plan", "reference_analysis": {"dominance": "text", "_source": "fallback"}}
      }
    }
  ]
