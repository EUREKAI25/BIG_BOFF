        "coherence":     {"type": "dict", "description": "Cohérence"},
        "plan":          {"type": "dict", "description": "Plan"},
        "captures":      {"type": "list", "description": "Screenshots"},
        "audit":         {"type": "dict", "description": "Résultat audit"},
        "trace":         {"type": "list", "description": "Trace complète"}
      },
      "dependencies": [
        "design.visual_intent.generate",
        "design.palette.generate",
