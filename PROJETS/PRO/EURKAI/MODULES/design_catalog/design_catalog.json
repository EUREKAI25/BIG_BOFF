        "site_family":     {"type": "str",      "required": false, "description": "Template family"},
        "reference_image": {"type": "str|None", "required": false, "description": "Référence optionnelle"},
        "reference_type":  {"type": "str",      "required": false, "description": "none | image | screenshot | mockup"},
        "output_root":     {"type": "str",      "required": false, "description": "Répertoire captures"},
        "api_key":         {"type": "str|None", "required": false, "description": "Clé Anthropic"},
