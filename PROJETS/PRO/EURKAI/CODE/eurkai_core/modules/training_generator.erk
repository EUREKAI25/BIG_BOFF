# EURKAI ERK — training_generator
# Version: 2.0.0
# Updated: 2026-04-29
# Source: modules/training_generator.py

Object:Module:training_generator:
  .name = training_generator
  .module_type = module
  .version = "2.0.0"
  .description = "Génère un parcours de formation interactif structuré en chapitres > leçons > tâches."
  .inputs = [topic, level, objectives, logics, format, catalog]
  .outputs = [training]
  .function_path = modules.training_generator.run
  .layer = generation
  .mode = llm_with_deterministic_fallback

Object:Module:training_generator:Input:topic:
  .type = string
  .required = true
  .description = "Sujet de la formation — agnostique, aucune référence métier"

Object:Module:training_generator:Input:level:
  .type = string
  .required = false
  .default = "intermediate"
  .allowed_values = [beginner, intermediate, advanced]

Object:Module:training_generator:Input:objectives:
  .type = list
  .required = false
  .description = "Objectifs pédagogiques — injectés depuis le manifest"

Object:Module:training_generator:Input:logics:
  .type = list
  .required = false
  .default = [editorial, technical, operational]
  .allowed_values = [editorial, technical, strategic, operational, cognitive, collaborative, creative]
  .description = "1 logic = 1 chapter. Le manifest choisit les logiques."

Object:Module:training_generator:Input:format:
  .type = string
  .required = false
  .default = "standard"
  .allowed_values = [short, standard, long]
  .description = "short=2 leçons/ch | standard=3 | long=5"

Object:Module:training_generator:Input:catalog:
  .type = dict
  .required = false
  .description = "Catalog EURKAI — présent = mode LLM, absent = mode déterministe"

Object:Module:training_generator:Input:theme:
  .type = dict
  .required = false
  .default = "DEFAULT_THEME (mode: default)"
  .description = "Thème visuel optionnel. Si absent : default_theme utilisé. Le design final appartient au projet consommateur."
  .note = "Les tokens fournis ne sont JAMAIS écrasés par les valeurs par défaut."
  .schema = ThemeInput

Object:Schema:ThemeInput:
  .fields = [mode, tokens, layout]

Object:Schema:ThemeInput:mode:
  .type = string
  .values = [default, custom]
  .description = "default = thème interne minimal | custom = thème injecté par le projet"

Object:Schema:ThemeInput:tokens:
  .type = dict
  .description = "Tokens CSS — tous optionnels. Seuls les fournis sont appliqués."
  .fields = [primary, accent, background, surface, text, muted, border, radius, font_family]
  .primary     = "Couleur principale (header, sidebar, boutons primaires)"
  .accent      = "Couleur d'accent (progression, highlights, CTA)"
  .background  = "Fond de page"
  .surface     = "Fond des cartes / panneaux"
  .text        = "Couleur du texte principal"
  .muted       = "Couleur du texte secondaire"
  .border      = "Couleur des bordures"
  .radius      = "Border radius (ex: 8px, 12px, 0px)"
  .font_family = "Police de caractères (valeur CSS complète)"

Object:Schema:ThemeInput:layout:
  .type = dict
  .description = "Options de mise en page — déclaratives, implémentation selon le renderer."
  .fields = [navigation, chapter_display, lesson_display]
  .navigation      = "sidebar | topbar | compact"
  .chapter_display = "accordion | timeline | cards"
  .lesson_display  = "accordion | stepper | page"

Object:Module:training_generator:ThemeContract:
  .rule_1 = "Le module ne possède pas l'identité visuelle du projet consommateur"
  .rule_2 = "DEFAULT_THEME est un thème de démonstration minimal, non un design final"
  .rule_3 = "Seules les CSS custom properties (var(--xxx)) sont utilisées dans le rendu HTML"
  .rule_4 = "Les couleurs sémantiques (types de blocs pédagogiques) sont fixes par conception"
  .rule_5 = "Tout projet appelant peut injecter son propre thème via manifest ou paramètre"

Object:Module:training_generator:Output:training:
  .type = dict
  .schema = InteractiveTrainingStructure

Object:Schema:InteractiveTrainingStructure:
  .fields = [training_title, level, estimated_duration, progression, chapters, final_validation, certificate_data]

Object:Schema:Chapter:
  .fields = [chapter_id, order, title, logic_type, objective, status, estimated_duration, lessons, chapter_validation]
  .status_values = [available, locked, completed]

Object:Schema:Lesson:
  .fields = [lesson_id, order, title, objective, status, content_blocks, interactive_tasks, completion_rules]
  .status_values = [available, locked, completed]

Object:Schema:ContentBlock:
  .fields = [type, title, content]
  .type_values = [theory, example, method, warning, prompt, checklist]

Object:Schema:InteractiveTask:
  .fields = [task_id, type, instruction, expected_user_action, validation_mode, success_criteria]
  .type_values = [question, exercise, prompt_practice, self_assessment, checklist]
  .validation_mode_values = [manual, self_check]

Object:Schema:CompletionRules:
  .fields = [required_tasks, minimum_score, can_skip]

Object:Schema:ChapterValidation:
  .fields = [type, instructions, success_criteria]
  .type_values = [quiz, practical_case, checklist, reflection]

Object:Schema:FinalValidation:
  .fields = [type, instructions, success_criteria]
  .type_values = [practical_case, quiz, action_plan]

Object:Schema:CertificateData:
  .fields = [enabled, requires_completion, tracked_items]
